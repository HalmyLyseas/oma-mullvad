#!/usr/bin/env bash
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
use_cage=1
[[ "${1:-}" == --no-cage ]] && use_cage=0
[[ $# -le 1 ]] || { echo "usage: test/ci-local [--no-cage]" >&2; exit 2; }
omarchy_shell_dir="${OMARCHY_SHELL_DIR:-/usr/share/omarchy/shell}"
omarchy_plugin_validator="${OMARCHY_PLUGIN_VALIDATOR:-$(command -v omarchy-plugin-validate || true)}"
[[ -d "$omarchy_shell_dir" ]] || { echo "Omarchy shell not found: $omarchy_shell_dir" >&2; exit 1; }
[[ -x "$omarchy_plugin_validator" ]] || { echo "Omarchy plugin validator not found: $omarchy_plugin_validator" >&2; exit 1; }
export OMARCHY_SHELL_DIR="$omarchy_shell_dir"
export OMARCHY_PLUGIN_VALIDATOR="$omarchy_plugin_validator"

status=0
run_step() {
  printf '== %s ==\n' "$*"
  "$@" || status=1
  printf '\n'
}

qmlroot="$(mktemp -d)"
archive_dir="$(mktemp -d)"
trap 'rm -rf "$qmlroot" "$archive_dir"' EXIT
ln -s "$omarchy_shell_dir" "$qmlroot/qs"
qmllint_bin="$(command -v qmllint || command -v /usr/lib/qt6/bin/qmllint || true)"

lint_tree() {
  local tree="$1" file rc=0
  [[ -n "$qmllint_bin" ]] || { echo "qmllint is unavailable" >&2; return 1; }
  while IFS= read -r -d '' file; do
    "$qmllint_bin" -I "$qmlroot" -I "$omarchy_shell_dir" "$tree/$file" >/dev/null || rc=1
  done < <(git -C "$root" ls-files -z '*.qml')
  return "$rc"
}

clean_archive() {
  local tree file
  tree="$(git -C "$root" write-tree)" || return 1
  git -C "$root" archive "$tree" | tar -x -C "$archive_dir" || return 1
  while IFS= read -r file; do
    [[ -f "$archive_dir/$file" ]] || { echo "clean archive missing $file" >&2; return 1; }
    bash -n "$archive_dir/$file" || return 1
  done < <(git -C "$root" ls-files 'test/probe/run*' 'test/probe/collect-result' 'test/mocks/*' 'test/all' 'test/ci-local' 'test/run-cli-contract')
  [[ -x "$archive_dir/test/all" ]] || { echo "clean archive test/all is not executable" >&2; return 1; }
  node --check "$archive_dir/test/probe/collect-result.mjs" || return 1
  node --check "$archive_dir/test/cli-contract.mjs" || return 1
  node --check "$archive_dir/test/verify-cli-contract-log.mjs" || return 1
  node --test "$archive_dir/tests"/*.test.js || return 1
  lint_tree "$archive_dir" || return 1
  "$omarchy_plugin_validator" "$archive_dir" || return 1
}

run_step lint_tree "$root"
run_step "$omarchy_plugin_validator" "$root"

if [[ "$use_cage" -eq 0 ]]; then
  run_step bash "$root/test/all"
else
  command -v cage >/dev/null || {
    echo "cage is required; use --no-cage for the current session" >&2
    exit 1
  }
  export WLR_BACKENDS=headless WLR_RENDERER=pixman WLR_LIBINPUT_NO_DEVICES=1
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$(mktemp -d)}"
  export QT_QUICK_BACKEND=software
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
  run_step cage -- bash "$root/test/all"
fi

run_step clean_archive

if [[ "$status" -eq 0 ]]; then
  echo "test/ci-local: ALL SUITES PASSED"
else
  echo "test/ci-local: FAILURES ABOVE"
fi
exit "$status"
