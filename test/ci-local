#!/usr/bin/env bash
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
use_cage=1
[[ "${1:-}" == --no-cage ]] && use_cage=0
[[ $# -le 1 ]] || { echo "usage: test/ci-local [--no-cage]" >&2; exit 2; }

status=0
run_step() {
  printf '== %s ==\n' "$*"
  "$@" || status=1
  printf '\n'
}

qmlroot="$(mktemp -d)"
archive_dir="$(mktemp -d)"
trap 'rm -rf "$qmlroot" "$archive_dir"' EXIT
ln -s /usr/share/omarchy/shell "$qmlroot/qs"
qmllint_bin="$(command -v qmllint || command -v /usr/lib/qt6/bin/qmllint || true)"

lint_tree() {
  local tree="$1" file rc=0
  [[ -n "$qmllint_bin" ]] || { echo "qmllint is unavailable" >&2; return 1; }
  while IFS= read -r -d '' file; do
    "$qmllint_bin" -I "$qmlroot" -I /usr/share/omarchy/shell "$tree/$file" >/dev/null || rc=1
  done < <(git -C "$root" ls-files -z '*.qml')
  return "$rc"
}

clean_archive() {
  local tree
  tree="$(git -C "$root" write-tree)" || return 1
  git -C "$root" archive "$tree" | tar -x -C "$archive_dir" || return 1
  node --test "$archive_dir/tests"/*.test.js || return 1
  lint_tree "$archive_dir" || return 1
  omarchy plugin validate "$archive_dir" || return 1
}

run_step lint_tree "$root"
run_step omarchy plugin validate "$root"

if [[ "$use_cage" -eq 0 ]]; then
  run_step bash "$root/test/all"
else
  command -v cage >/dev/null || {
    echo "cage is required; use --no-cage for the current session" >&2
    exit 1
  }
  export WLR_BACKENDS=headless WLR_RENDERER=pixman WLR_LIBINPUT_NO_DEVICES=1
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$(mktemp -d)}"
  export QT_QUICK_BACKEND=software
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
  run_step cage -- bash "$root/test/all"
fi

run_step clean_archive

if [[ "$status" -eq 0 ]]; then
  echo "test/ci-local: ALL SUITES PASSED"
else
  echo "test/ci-local: FAILURES ABOVE"
fi
exit "$status"
