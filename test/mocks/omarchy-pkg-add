#!/bin/bash
# PATH-shadowing mock of Omarchy's own omarchy-pkg-add for
# scripts/install-mullvad tests: logs argv to $MOCK_LOG, exits
# $MOCK_PKG_ADD_EXIT (default 0), never calls pacman/sudo for real.
set -uo pipefail
echo "omarchy-pkg-add $*" >> "${MOCK_LOG:-/dev/null}"
exit "${MOCK_PKG_ADD_EXIT:-0}"
