#!/usr/bin/env bash
# test/mocks/mullvad -- PATH-shadowing mock of the `mullvad` CLI, for the
# deterministic probe suite (test/probe/). Never touches the real daemon:
# every response is a canned fixture under test/fixtures/cli/ (captured from
# the real 2026.4 CLI, redacted -- see 24-s10-native-process.md) or a
# synthesized failure/hang/flood shape. Behavior is steered by
# $MULLVAD_MOCK_MODE (default "ok"):
#
#   ok    -- every subcommand below succeeds with its fixture; `account
#            login` reads ONE stdin line and prints "login-received-len=<n>",
#            or fails with the real INVALID_INPUT text if the line is empty
#            (the exact upstream bug this rework exists to make impossible:
#            exchange/22-login-stdin-bug.md).
#   hang  -- every invocation sleeps 600s; must be killed by Service.qml's
#            watchdog, never by anything in this script.
#   flood -- every invocation loops forever, writing 64 KiB chunks of `x`
#            with NO newline ever (N6, 25-fable-review-s10.md: a genuine
#            streaming flood that never exits on its own, unlike a one-shot
#            bounded dump -- the only way it ends is Service.qml's
#            watchdog/overflow-cap logic actually killing it, which is
#            exactly what this mode exists to prove).
#   fail  -- `mullvad --version` still succeeds (so `installed` stays true and
#            the read queue keeps going -- this is what "queue continues"
#            means in the probe assertions); every other subcommand,
#            including `account login`, exits 2 with stderr text.
#   action-hang -- every READ succeeds exactly like `ok`; only `connect`
#            sleeps 600s (N6: exercises Service.qml's actionWatchdog
#            specifically, as distinct from the read-side `hang` mode above,
#            which hangs the very first read and never lets `installed`
#            become true at all).
#
# If $MULLVAD_MOCK_LOG is set, every invocation appends its argv and the
# `command -v mullvad` resolution to that file -- test/probe/run greps it to
# prove PATH shadowing actually took effect for this run (never assumed).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIXTURES="$SCRIPT_DIR/../fixtures/cli"
MODE="${MULLVAD_MOCK_MODE:-ok}"

if [[ -n "${MULLVAD_MOCK_LOG:-}" ]]; then
  {
    echo "PID=$$ MODE=$MODE ARGV: $*"
    echo -n "  command -v mullvad -> "
    command -v mullvad
  } >> "$MULLVAD_MOCK_LOG" 2>&1
fi

case "$MODE" in
  hang)
    exec sleep 600
    ;;
  flood)
    # 64 KiB chunks of 'x', no newline, forever -- built once, then printed
    # in a loop via a bash builtin (no per-iteration fork). Quickshell keeps
    # draining the pipe (SplitParser buffers looking for a newline that
    # never comes) so this never blocks; the only way it stops is being
    # signalled from outside.
    chunk="$(head -c 65536 /dev/zero | tr '\0' 'x')"
    while true; do printf '%s' "$chunk"; done
    ;;
esac

if [[ "$MODE" == "action-hang" && "$*" == "connect" ]]; then
  exec sleep 600
fi

# --- account login: reads exactly one stdin line ----------------------------
if [[ "${1:-}" == "account" && "${2:-}" == "login" ]]; then
  if [[ "$MODE" == "fail" ]]; then
    echo "Enter an account number: Error: gRPC call returned error Caused by: code: 'Client specified an invalid argument', message: INVALID_INPUT" >&2
    exit 2
  fi
  IFS= read -r line || line=""
  if [[ -z "$line" ]]; then
    echo "Enter an account number: Error: gRPC call returned error Caused by: code: 'Client specified an invalid argument', message: INVALID_INPUT" >&2
    exit 1
  fi
  # Also recorded to MULLVAD_MOCK_LOG (not just stdout): the probe's
  # assertion needs the exact received length independent of whatever
  # Service.qml's actionStatus text says, so a garbled-but-nonempty stdin
  # payload can't pass as a false "login worked" (exchange/22's regression
  # target is the exact byte count, not just non-emptiness).
  if [[ -n "${MULLVAD_MOCK_LOG:-}" ]]; then
    echo "  login-received-len=${#line}" >> "$MULLVAD_MOCK_LOG"
  fi
  echo "login-received-len=${#line}"
  exit 0
fi

if [[ "$MODE" == "fail" && "$*" != "--version" ]]; then
  echo "mock fail: mullvad $*" >&2
  exit 2
fi

# --- ok (and fail-mode's still-succeeding --version) mode: canned fixtures --
case "$*" in
  "--version") cat "$FIXTURES/version.txt"; exit 0 ;;
  "status --json") cat "$FIXTURES/status-json.txt"; exit 0 ;;
  "status --json listen")
    cat "$FIXTURES/status-listen.txt"
    # Long-lived, exactly like the real listener: block until signalled.
    exec sleep 600
    ;;
  "account get") cat "$FIXTURES/account-get-redacted.txt"; exit 0 ;;
  "relay list") cat "$FIXTURES/relay-list-full.txt"; exit 0 ;;
  "relay get") cat "$FIXTURES/relay-get.txt"; exit 0 ;;
  "lockdown-mode get") cat "$FIXTURES/lockdown-get.txt"; exit 0 ;;
  "auto-connect get") cat "$FIXTURES/autoconnect-get.txt"; exit 0 ;;
  "lan get") cat "$FIXTURES/lan-get.txt"; exit 0 ;;
  "dns get") cat "$FIXTURES/dns-get.txt"; exit 0 ;;
  "anti-censorship get") cat "$FIXTURES/anticensorship-get.txt"; exit 0 ;;
  "split-tunnel list") cat "$FIXTURES/splittunnel-list.txt"; exit 0 ;;
  "version") cat "$FIXTURES/version-daemon.txt"; exit 0 ;;
  "connect") echo "Connecting"; exit 0 ;;
  "disconnect") echo "Disconnecting"; exit 0 ;;
  *)
    echo "mullvad mock: unhandled invocation: $*" >&2
    exit 2
    ;;
esac
