#!/usr/bin/env bash
# PATH-shadowing mock of the `mullvad` CLI (never the real daemon): canned
# fixtures from test/fixtures/cli/, or hang/flood/fail shapes per $MULLVAD_MOCK_MODE.
# `account login` echoes the stdin line length; $MULLVAD_MOCK_LOG records every argv.
set -uo pipefail

# Resolved via `readlink -f`, not a plain dirname of BASH_SOURCE: the
# "removed" probe scenario invokes this script through a symlink that gets
# deleted mid-run, and BASH_SOURCE reflects the symlink's own directory.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
FIXTURES="$SCRIPT_DIR/../fixtures/cli"
MODE="${MULLVAD_MOCK_MODE:-ok}"

# ms-precision sleep with only bash arithmetic (no bc/awk dependency).
_sleep_ms() {
  local ms="${1:-0}"
  printf -v _s '%d.%03d' $((ms / 1000)) $((ms % 1000))
  sleep "$_s"
}

# Drives MULLVAD_MOCK_LISTEN_SCRIPT: each line is "<delay-ms> <payload>",
# payload "EXIT <code>" ends the stream, "STDERR <text>" writes to stderr.
# Anything else is relayed to stdout verbatim, one flushed line at a time.
_run_listen_script() {
  local script="$1" delay payload
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    delay="${line%% *}"
    payload="${line#* }"
    _sleep_ms "$delay"
    case "$payload" in
      "EXIT "*)
        if [[ -n "${MULLVAD_MOCK_LISTENER_DIED_MARKER:-}" ]]; then
          : > "$MULLVAD_MOCK_LISTENER_DIED_MARKER"
        fi
        exit "${payload#EXIT }"
        ;;
      "STDERR "*) printf '%s\n' "${payload#STDERR }" >&2 ;;
      *) printf '%s\n' "$payload" ;;
    esac
  done < "$script"
  # Script exhausted with no EXIT line: block like the real long-lived listener.
  exec sleep 600
}

if [[ -n "${MULLVAD_MOCK_LOG:-}" ]]; then
  {
    echo "PID=$$ MODE=$MODE ARGV: $*"
    echo -n "  command -v mullvad -> "
    command -v mullvad
  } >> "$MULLVAD_MOCK_LOG" 2>&1
fi

case "$MODE" in
  hang)
    exec sleep 600
    ;;
  flood)
    # 64 KiB chunks of 'x', no newline, forever -- the only way this stops
    # is being signalled from outside (SplitParser buffers looking for a
    # newline that never comes, so it never blocks on its own).
    chunk="$(head -c 65536 /dev/zero | tr '\0' 'x')"
    while true; do printf '%s' "$chunk"; done
    ;;
esac

if [[ "$MODE" == "action-hang" && "$*" == "connect" ]]; then
  exec sleep 600
fi

# noversion: the CLI itself fails its version probe, the one read every
# refreshAll() starts with -- distinct from "removed" (binary absent) and
# from "fail" (--version deliberately still works there).
if [[ "$MODE" == "noversion" && "$*" == "--version" ]]; then
  echo "mock noversion: mullvad --version" >&2
  exit 1
fi

# untestedversion: --version reports a CLI release ahead of the pinned
# SUPPORTED_CLI_VERSIONS list; every other invocation behaves like "ok".
if [[ "$MODE" == "untestedversion" && "$*" == "--version" ]]; then
  echo "mullvad-cli 2027.1"
  exit 0
fi

# --- account login: reads exactly one stdin line ----------------------------
if [[ "${1:-}" == "account" && "${2:-}" == "login" ]]; then
  if [[ "$MODE" == "fail" ]]; then
    echo "Enter an account number: Error: gRPC call returned error Caused by: code: 'Client specified an invalid argument', message: INVALID_INPUT" >&2
    exit 2
  fi
  IFS= read -r line || line=""
  if [[ -z "$line" ]]; then
    echo "Enter an account number: Error: gRPC call returned error Caused by: code: 'Client specified an invalid argument', message: INVALID_INPUT" >&2
    exit 1
  fi
  # Also recorded to MULLVAD_MOCK_LOG (not just stdout): the probe's
  # assertion needs the exact received length, so a garbled-but-nonempty
  # stdin payload can't pass as a false "login worked".
  if [[ -n "${MULLVAD_MOCK_LOG:-}" ]]; then
    echo "  login-received-len=${#line}" >> "$MULLVAD_MOCK_LOG"
  fi
  echo "login-received-len=${#line}"
  exit 0
fi

if [[ "$MODE" == "fail" && "$*" != "--version" ]]; then
  echo "mock fail: mullvad $*" >&2
  exit 2
fi

# --- ok (and fail-mode's still-succeeding --version) mode: canned fixtures --
case "$*" in
  "--version") cat "$FIXTURES/version.txt"; exit 0 ;;
  "status --json")
    # A one-shot delayed-poll trigger: only the invocation that finds the
    # trigger file is slowed, and it consumes the file so later polls are not.
    if [[ -n "${MULLVAD_MOCK_STATUS_DELAY_TRIGGER:-}" && -f "$MULLVAD_MOCK_STATUS_DELAY_TRIGGER" ]]; then
      rm -f "$MULLVAD_MOCK_STATUS_DELAY_TRIGGER"
      _sleep_ms "${MULLVAD_MOCK_STATUS_DELAY_MS:-1500}"
    fi
    cat "$FIXTURES/status-json.txt"
    exit 0
    ;;
  "status --json listen")
    # A prior scripted run's EXIT step marks this file; the very next listen
    # replays connected once instead of re-running the script from line one.
    if [[ -n "${MULLVAD_MOCK_LISTENER_DIED_MARKER:-}" && -f "$MULLVAD_MOCK_LISTENER_DIED_MARKER" ]]; then
      rm -f "$MULLVAD_MOCK_LISTENER_DIED_MARKER"
      cat "$FIXTURES/listen-scripts/respawn-connected.txt"
      exec sleep 600
    fi
    if [[ -n "${MULLVAD_MOCK_LISTEN_SCRIPT:-}" ]]; then
      _run_listen_script "$MULLVAD_MOCK_LISTEN_SCRIPT"
    fi
    cat "$FIXTURES/status-listen.txt"
    # Long-lived, exactly like the real listener: block until signalled.
    exec sleep 600
    ;;
  "account get") cat "$FIXTURES/account-get-redacted.txt"; exit 0 ;;
  "relay list") cat "$FIXTURES/relay-list-full.txt"; exit 0 ;;
  "relay get") cat "$FIXTURES/relay-get.txt"; exit 0 ;;
  "lockdown-mode get") cat "$FIXTURES/lockdown-get.txt"; exit 0 ;;
  "auto-connect get") cat "$FIXTURES/autoconnect-get.txt"; exit 0 ;;
  "lan get") cat "$FIXTURES/lan-get.txt"; exit 0 ;;
  "dns get") cat "$FIXTURES/dns-get.txt"; exit 0 ;;
  "anti-censorship get") cat "$FIXTURES/anticensorship-get.txt"; exit 0 ;;
  "split-tunnel list") cat "$FIXTURES/splittunnel-list.txt"; exit 0 ;;
  "version") cat "$FIXTURES/version-daemon.txt"; exit 0 ;;
  "connect") echo "Connecting"; exit 0 ;;
  "disconnect") echo "Disconnecting"; exit 0 ;;
  *)
    echo "mullvad mock: unhandled invocation: $*" >&2
    exit 2
    ;;
esac
