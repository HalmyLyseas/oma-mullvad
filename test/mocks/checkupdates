#!/usr/bin/env bash
# test/mocks/checkupdates -- PATH-shadowing mock of pacman-contrib's
# checkupdates for scripts/mullvad-update-check tests. Steered by
# $MOCK_MODE (default "updates"):
#   updates -- a mix of packages including both mullvad ones, exit 0
#   none    -- no stdout at all, exit 2 (checkupdates' "nothing to update")
#   offline -- a sync error on stderr, exit 1 (checkupdates' "could not check")
#   hang    -- sleeps 30s, long enough that it is only ever brought down by
#              being killed (scripts.test.sh kills it via a short
#              MULLVAD_UPDATE_CHECK_TIMEOUT/the wrapper's own internal
#              `timeout`; test/probe/run's updatecheck-hang scenario kills it
#              via Service.qml's own updateCheckWatchdog, N6,
#              25-fable-review-s10.md).
#
# If $MULLVAD_MOCK_LOG is set (test/probe/run only -- test/scripts.test.sh
# never sets it), logs "PID=$$ ..." like test/mocks/mullvad does, so
# test/probe/run's check_no_orphans can prove this process (and not just the
# wrapper script that spawned it) is actually gone afterwards.
set -uo pipefail
MODE="${MOCK_MODE:-updates}"

if [[ -n "${MULLVAD_MOCK_LOG:-}" ]]; then
  echo "PID=$$ MODE=$MODE checkupdates" >> "$MULLVAD_MOCK_LOG"
fi

case "$MODE" in
  updates)
    echo "openai-codex-desktop 26.820.71523-1 -> 26.820.80927-1"
    echo "mullvad-vpn 2026.3-1 -> 2026.4-1"
    echo "mullvad-vpn-daemon 2026.3-1 -> 2026.4-1"
    exit 0
    ;;
  none)
    exit 2
    ;;
  offline)
    echo "error: failed to synchronize all databases" >&2
    exit 1
    ;;
  hang)
    sleep 30
    exit 0
    ;;
  *)
    echo "checkupdates mock: unknown MOCK_MODE=$MODE" >&2
    exit 1
    ;;
esac
