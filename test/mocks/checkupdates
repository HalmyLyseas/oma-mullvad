#!/usr/bin/env bash
# PATH-shadowing mock of pacman-contrib's checkupdates for
# scripts/mullvad-update-check tests. $MOCK_MODE selects updates/none/
# offline/hang, matching checkupdates' own exit-code contract.
#
# $MULLVAD_MOCK_LOG, when set, logs "PID=$$ ..." like test/mocks/mullvad
# does, so test/probe/run's check_no_orphans can prove this process itself
# is gone afterwards, not just the wrapper script that spawned it.
set -uo pipefail
MODE="${MOCK_MODE:-updates}"

if [[ -n "${MULLVAD_MOCK_LOG:-}" ]]; then
  echo "PID=$$ MODE=$MODE checkupdates" >> "$MULLVAD_MOCK_LOG"
fi

case "$MODE" in
  updates)
    echo "openai-codex-desktop 26.820.71523-1 -> 26.820.80927-1"
    echo "mullvad-vpn 2026.3-1 -> 2026.4-1"
    echo "mullvad-vpn-daemon 2026.3-1 -> 2026.4-1"
    exit 0
    ;;
  none)
    exit 2
    ;;
  offline)
    echo "error: failed to synchronize all databases" >&2
    exit 1
    ;;
  hang)
    sleep 30
    exit 0
    ;;
  *)
    echo "checkupdates mock: unknown MOCK_MODE=$MODE" >&2
    exit 1
    ;;
esac
