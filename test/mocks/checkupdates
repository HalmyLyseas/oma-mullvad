#!/usr/bin/env bash
set -uo pipefail
printf 'checkupdates <%s>\n' "$*" >> "${MULLVAD_MOCK_LOG:?}"
printf 'PID=%s MODE=%s CHECKUPDATES\n' "$$" "${MULLVAD_MOCK_MODE:-ok}" >> "$MULLVAD_MOCK_LOG"
case "${MULLVAD_MOCK_MODE:-ok}" in
  update-hang) exec sleep 600 ;;
  update-stubborn)
    trap '' TERM INT
    while true; do sleep 1; done
    ;;
  no-updates) exit 2 ;;
esac
printf 'mullvad-vpn 2026.4-1 -> 2026.5-1\nunrelated 1 -> 2\n'
