#!/bin/bash
# PATH-shadowing mock of systemctl for scripts/install-mullvad tests: real
# exit-code contract for is-active/is-enabled --quiet mullvad-daemon, via
# $MOCK_DAEMON_ACTIVE/$MOCK_DAEMON_ENABLED; anything else just logs.
set -uo pipefail
echo "systemctl $*" >> "${MOCK_LOG:-/dev/null}"

if [[ "${1:-}" == "is-active" ]]; then
  if [[ "${MOCK_DAEMON_ACTIVE:-0}" == "1" ]]; then
    echo "active"
    exit 0
  else
    echo "inactive"
    exit 3
  fi
fi

if [[ "${1:-}" == "is-enabled" ]]; then
  if [[ "${MOCK_DAEMON_ENABLED:-0}" == "1" ]]; then
    echo "enabled"
    exit 0
  else
    echo "disabled"
    exit 1
  fi
fi

exit 0
