#!/bin/bash
# PATH-shadowing mock of systemctl for scripts/install-mullvad tests.
# `is-active --quiet mullvad-daemon` is emulated via $MOCK_DAEMON_ACTIVE
# (matching systemctl's real exit-code contract); anything else just logs.
set -uo pipefail
echo "systemctl $*" >> "${MOCK_LOG:-/dev/null}"

if [[ "${1:-}" == "is-active" ]]; then
  if [[ "${MOCK_DAEMON_ACTIVE:-0}" == "1" ]]; then
    echo "active"
    exit 0
  else
    echo "inactive"
    exit 3
  fi
fi

exit 0
