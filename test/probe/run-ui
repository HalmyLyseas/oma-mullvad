#!/usr/bin/env bash
set -uo pipefail

probe_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
plugin_dir="$(cd "$probe_dir/../.." && pwd)"
omarchy_shell_dir="${OMARCHY_SHELL_DIR:-/usr/share/omarchy/shell}"
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT
failures=0

if ! command -v qs >/dev/null 2>&1; then
  echo "UI probe skipped: qs is unavailable"
  exit 0
fi

mkdir -p "$scratch/qmlroot" "$scratch/bin"
ln -s "$omarchy_shell_dir" "$scratch/qmlroot/qs"
ln -s "$plugin_dir/test/mocks/mullvad" "$scratch/bin/mullvad"
ln -s "$plugin_dir/test/mocks/mullvad-exclude" "$scratch/bin/mullvad-exclude"
ln -s "$plugin_dir/test/mocks/ps" "$scratch/bin/ps"
ln -s "$plugin_dir/test/mocks/pgrep" "$scratch/bin/pgrep"
ln -s "$plugin_dir/test/mocks/checkupdates" "$scratch/bin/checkupdates"
ln -s "$plugin_dir/test/mocks/touch" "$scratch/bin/touch"
for executable in mullvad mullvad-exclude ps pgrep checkupdates touch; do
  resolved="$(PATH="$scratch/bin" command -v "$executable")" || {
    echo "missing mock executable: $executable" >&2
    exit 1
  }
  [[ "$(readlink -f "$resolved")" == "$(readlink -f "$plugin_dir/test/mocks/$executable")" ]] || {
    echo "unsafe executable boundary: $executable -> $resolved" >&2
    exit 1
  }
done

check_json() {
  local json="$1" label="$2"
  shift 2
  if node "$probe_dir/json-assert.mjs" "$json" "$@"; then
    printf 'ok - %s\n' "$label"
  else
    printf 'not ok - %s\n' "$label"
    failures=$((failures + 1))
  fi
}

run_case() {
  local scenario="$1" log="$scratch/$1.log" mocklog="$scratch/$1.mock"
  : > "$mocklog"
  MULLVAD_MOCK_MODE=ok MULLVAD_MOCK_LOG="$mocklog" \
    MULLVAD_PACMAN_LOCAL_DB="$plugin_dir/test/fixtures/pacman-local" \
    MULLVAD_UI_SCENARIO="$scenario" MULLVAD_PLUGIN_DIR="$plugin_dir" \
    QML_IMPORT_PATH="$scratch/qmlroot" PATH="$scratch/bin:$PATH" \
    timeout 20 qs -n -p "$probe_dir/ui-probe.qml" > "$log" 2>&1
  local command_status=$?
  "$probe_dir/collect-result" "$log" "$command_status" "$mocklog"
}

json="$(run_case state-icons)"
check_json "$json" "real BarWidget and Panel instantiate without engine errors" note empty ignored
check_json "$json" "Panel receives the singleton service" panelLoaded eq true panelServiceMatches eq true
check_json "$json" "bar icon follows service truth" connectedIcon eq connected errorIcon eq error
check_json "$json" "error state reaches the bar tooltip" errorTooltip contains error

json="$(run_case lifecycle)"
check_json "$json" "service-null lifecycle completes without engine errors" note empty ignored
check_json "$json" "Panel exists while the service exists" firstPanelLoaded eq true
check_json "$json" "Panel Loader deactivates when the service disappears" loaderInactive eq true loaderStatusNull eq true
check_json "$json" "stale Panel is destroyed" panelDestroyed eq true

json="$(run_case widget-reload)"
check_json "$json" "widget reload preserves the keepLoaded service instance" note empty ignored sameService eq true
check_json "$json" "reloaded widget injects the retained service into its panel" panelServiceMatches eq true

json="$(run_case replacement-bar)"
check_json "$json" "replacement bar without service access destroys the panel" note empty ignored panelDestroyed eq true
check_json "$json" "replacement bar renders an explicit unavailable state" unavailableTooltip eq 'Mullvad controls unavailable in this bar'

json="$(run_case facade-contract)"
check_json "$json" "scoped facade exposes only the plugin service" ownService eq true foreignServiceNull eq true appLibraryNull eq true
check_json "$json" "scoped facade accepts only own-ID settings updates" foreignUpdateIgnored eq true ownUpdateRecorded eq true
check_json "$json" "scalar bar and popup ownership APIs remain usable" scalarPropertiesUsable eq true popupOwned eq true popupReleased eq true

json="$(run_case availability-cli)"
check_json "$json" "Overview remains available without the CLI" cliReady eq false overviewAvailable eq true
check_json "$json" "CLI-dependent pages lock without the CLI" locationsAvailable eq false advancedAvailable eq false excludedAvailable eq false
check_json "$json" "unavailable CLI cannot navigate away from Overview" selectedPage eq 0 barTooltip contains 'not installed'
check_json "$json" "System remains available without the CLI" systemAvailable eq true systemSelectedPage eq 4 systemPageLoaded eq true

json="$(run_case availability-daemon)"
check_json "$json" "daemon unavailability keeps the panel on Overview" cliReady eq false selectedPage eq 0
check_json "$json" "daemon-dependent pages and tunnel UI remain unavailable" locationsAvailable eq false barTooltip contains daemon barTooltip contains unavailable
check_json "$json" "System remains available without the daemon" systemAvailable eq true systemSelectedPage eq 4 systemPageLoaded eq true

json="$(run_case availability-ready)"
check_json "$json" "pages unlock when CLI and daemon are ready" cliReady eq true advancedAvailable eq true
check_json "$json" "ready panel can navigate to Advanced" selectedPage eq 2

json="$(run_case excluded-groups)"
check_json "$json" "Excluded page opens without engine errors" note empty ignored selectedPage eq 3
check_json "$json" "fourteen excluded processes render as one app group" processCount eq 14 groupCount eq 1
check_json "$json" "group exposes the root process label and member count" firstLabel ieq chromium firstCount eq 14
check_json "$json" "Excluded page receives the grouped model" pageLoaded eq true pageGroupCount eq 1

json="$(run_case local-app-catalogue)"
check_json "$json" "local application catalogue scenario loads the Excluded page" note empty ignored selectedPage eq 3
check_json "$json" "probe matches the scoped Omarchy 4.0.3 facade" appLibraryNull eq true ownService eq true foreignServiceNull eq true
check_json "$json" "excluded-process labels use local desktop metadata" excludedMetadataCount ge 1
check_json "$json" "local catalogue does not require the host app library" emptyText eq 'No installed applications match your search.'

json="$(run_case recent-apps)"
check_json "$json" "empty query resolves recent desktop IDs" note empty ignored recentCount ge 1
check_json "$json" "non-empty query searches the complete local catalogue" searchCount ge 1
check_json "$json" "launch recording clears search and updates only the plugin settings" queryAfterLaunch empty ignored updateId eq io.github.kallupx.oma-mullvad
recent_first="$(node -e 'process.stdout.write(String(JSON.parse(process.argv[1]).recentFirst || ""))' "$json")"
check_json "$json" "recent launch persistence preserves unrelated settings" savedRecentFirst eq "$recent_first" refreshIntervalSec eq 30
check_json "$json" "leaving the Excluded tab clears stale search" queryAfterLeave empty ignored

json="$(run_case launch-result)"
check_json "$json" "failed excluded launch keeps panel and recent state unchanged" rejected eq true failurePreserved eq true
check_json "$json" "successful excluded launch records, clears, and closes" accepted eq true closedAfterSuccess eq true queryClearedAfterSuccess eq true
check_json "$json" "successful spaced desktop ID is recorded" savedRecentFirst eq 'Zoom (Web).desktop'
if grep -Fq 'mullvad-exclude <uwsm-app> <--> <gtk-launch> <Zoom (Web).desktop>' "$scratch/launch-result.mock"; then
  printf 'ok - excluded UI launch stays inside the mock boundary\n'
else
  printf 'not ok - excluded UI launch stays inside the mock boundary\n'
  failures=$((failures + 1))
fi

json="$(run_case settings-fresh-merge)"
check_json "$json" "stale panel writes merge the current scoped-host entry" note empty ignored refreshIntervalSec eq 99 siblingValue eq preserve-me favoriteCount eq 1

json="$(run_case interactive-controls)"
check_json "$json" "real panel shortcut routing reaches tabs, locations, favorites, recents, and advanced page" note empty ignored tabsWorked eq true locationCount gt 0 serverCount gt 0 favoriteCount eq 1 recentCount eq 1 advancedPageLoaded eq true
check_json "$json" "real dropdown objects open, close, and preserve bounded selections" dropdownLabel eq Gothenburg searchableLabel eq Sweden dropdownChanged eq got searchableChanged eq se
check_json "$json" "map projection renders the selected location" mapProjection eq true
check_json "$json" "shortcut tunnel routing and confirmation cancel signals remain explicit" connectControlRan eq true disconnectControlRan eq true confirmationClosed eq true busyBlocksLocation eq true accountCanceled eq true removalCanceled eq true
for argv in 'ARGV: connect' 'ARGV: disconnect'; do
  if ! grep -Fq "$argv" "$scratch/interactive-controls.mock"; then
    echo "not ok - UI shortcut routing did not dispatch ${argv#ARGV: }" >&2
    failures=$((failures + 1))
  fi
done

exit "$((failures > 0))"
