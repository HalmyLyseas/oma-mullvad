#!/usr/bin/env bash
set -uo pipefail

probe_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
plugin_dir="$(cd "$probe_dir/../.." && pwd)"
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT
failures=0

if ! command -v qs >/dev/null 2>&1; then
  echo "UI probe skipped: qs is unavailable"
  exit 0
fi

mkdir -p "$scratch/qmlroot" "$scratch/bin"
ln -s /usr/share/omarchy/shell "$scratch/qmlroot/qs"
ln -s "$plugin_dir/test/mocks/mullvad" "$scratch/bin/mullvad"
ln -s "$plugin_dir/test/mocks/ps" "$scratch/bin/ps"

field() {
  node -e 'const v=JSON.parse(process.argv[1])[process.argv[2]]; process.stdout.write(v == null ? "" : String(v))' "$1" "$2"
}

check() {
  if eval "$1"; then printf 'ok - %s\n' "$2"; else printf 'not ok - %s\n' "$2"; failures=$((failures + 1)); fi
}

run_case() {
  local scenario="$1" log="$scratch/$1.log" mocklog="$scratch/$1.mock"
  : > "$mocklog"
  MULLVAD_MOCK_MODE=ok MULLVAD_MOCK_LOG="$mocklog" \
    MULLVAD_UI_SCENARIO="$scenario" MULLVAD_PLUGIN_DIR="$plugin_dir" \
    QML_IMPORT_PATH="$scratch/qmlroot" PATH="$scratch/bin:$PATH" \
    timeout 20 qs -n -p "$probe_dir/ui-probe.qml" > "$log" 2>&1
  if rg -n 'TypeError|ReferenceError|^\s*ERROR:' "$log" >/dev/null; then
    sed -n '1,240p' "$log" >&2
    return 1
  fi
  grep -o 'PROBE_RESULT .*' "$log" | tail -n1 | sed 's/^PROBE_RESULT //'
}

json="$(run_case state-icons)"
check "[[ -n '$json' && -z \"$(field "$json" note)\" ]]" "real BarWidget and Panel instantiate without engine errors"
check "[[ \"$(field "$json" panelLoaded)\" == true && \"$(field "$json" panelServiceMatches)\" == true ]]" "Panel receives the singleton service"
check "[[ \"$(field "$json" connectedIcon)\" == connected && \"$(field "$json" errorIcon)\" == error ]]" "bar icon follows service truth"
check "[[ \"$(field "$json" errorTooltip)\" == *error* ]]" "error state reaches the bar tooltip"

json="$(run_case lifecycle)"
check "[[ -n '$json' && -z \"$(field "$json" note)\" ]]" "service-null lifecycle completes without engine errors"
check "[[ \"$(field "$json" firstPanelLoaded)\" == true ]]" "Panel exists while the service exists"
check "[[ \"$(field "$json" loaderInactive)\" == true && \"$(field "$json" loaderStatusNull)\" == true ]]" "Panel Loader deactivates when the service disappears"
check "[[ \"$(field "$json" panelDestroyed)\" == true ]]" "stale Panel is destroyed"

json="$(run_case widget-reload)"
check "[[ -n '$json' && -z \"$(field "$json" note)\" && \"$(field "$json" sameService)\" == true ]]" "widget reload preserves the keepLoaded service instance"
check "[[ \"$(field "$json" panelServiceMatches)\" == true ]]" "reloaded widget injects the retained service into its panel"

json="$(run_case replacement-bar)"
check "[[ -n '$json' && -z \"$(field "$json" note)\" && \"$(field "$json" panelDestroyed)\" == true ]]" "replacement bar without service access destroys the panel"
check "[[ \"$(field "$json" unavailableTooltip)\" == 'Mullvad controls unavailable in this bar' ]]" "replacement bar renders an explicit unavailable state"

json="$(run_case facade-contract)"
check "[[ \"$(field "$json" ownService)\" == true && \"$(field "$json" foreignServiceNull)\" == true && \"$(field "$json" appLibraryNull)\" == true ]]" "scoped facade exposes only the plugin service"
check "[[ \"$(field "$json" foreignUpdateIgnored)\" == true && \"$(field "$json" ownUpdateRecorded)\" == true ]]" "scoped facade accepts only own-ID settings updates"
check "[[ \"$(field "$json" scalarPropertiesUsable)\" == true && \"$(field "$json" popupOwned)\" == true && \"$(field "$json" popupReleased)\" == true ]]" "scalar bar and popup ownership APIs remain usable"

json="$(run_case availability-cli)"
check "[[ \"$(field "$json" cliReady)\" == false && \"$(field "$json" overviewAvailable)\" == true ]]" "Overview remains available without the CLI"
check "[[ \"$(field "$json" locationsAvailable)\" == false && \"$(field "$json" advancedAvailable)\" == false && \"$(field "$json" excludedAvailable)\" == false ]]" "CLI-dependent pages lock without the CLI"
check "[[ \"$(field "$json" selectedPage)\" == 0 && \"$(field "$json" barTooltip)\" == *not\ installed* ]]" "unavailable CLI cannot navigate away from Overview"

json="$(run_case availability-daemon)"
check "[[ \"$(field "$json" cliReady)\" == false && \"$(field "$json" selectedPage)\" == 0 ]]" "daemon unavailability keeps the panel on Overview"
check "[[ \"$(field "$json" locationsAvailable)\" == false && \"$(field "$json" barTooltip)\" == *daemon*unavailable* ]]" "daemon-dependent pages and tunnel UI remain unavailable"

json="$(run_case availability-ready)"
check "[[ \"$(field "$json" cliReady)\" == true && \"$(field "$json" advancedAvailable)\" == true ]]" "pages unlock when CLI and daemon are ready"
check "[[ \"$(field "$json" selectedPage)\" == 2 ]]" "ready panel can navigate to Advanced"

json="$(run_case excluded-groups)"
check "[[ -n '$json' && -z \"$(field "$json" note)\" && \"$(field "$json" selectedPage)\" == 3 ]]" "Excluded page opens without engine errors"
check "[[ \"$(field "$json" processCount)\" == 14 && \"$(field "$json" groupCount)\" == 1 ]]" "fourteen excluded processes render as one app group"
check "[[ \"$(field "$json" firstLabel)\" == chromium && \"$(field "$json" firstCount)\" == 14 ]]" "group exposes the root process label and member count"
check "[[ \"$(field "$json" pageLoaded)\" == true && \"$(field "$json" pageGroupCount)\" == 1 ]]" "Excluded page receives the grouped model"

json="$(run_case local-app-catalogue)"
check "[[ -n '$json' && -z \"$(field "$json" note)\" && \"$(field "$json" selectedPage)\" == 3 ]]" "local application catalogue scenario loads the Excluded page"
check "[[ \"$(field "$json" appLibraryNull)\" == true && \"$(field "$json" ownService)\" == true && \"$(field "$json" foreignServiceNull)\" == true ]]" "probe matches the scoped Omarchy 4.0.3 facade"
check "[[ \"$(field "$json" emptyText)\" == 'No installed applications match your search.' ]]" "local catalogue does not require the host app library"

json="$(run_case recent-apps)"
check "[[ -n '$json' && -z \"$(field "$json" note)\" && \"$(field "$json" recentCount)\" -ge 1 ]]" "empty query resolves recent desktop IDs"
check "[[ \"$(field "$json" searchCount)\" -ge 1 ]]" "non-empty query searches the complete local catalogue"
check "[[ -z \"$(field "$json" queryAfterLaunch)\" && \"$(field "$json" updateId)\" == io.github.kallupx.oma-mullvad ]]" "launch recording clears search and updates only the plugin settings"
check "[[ \"$(field "$json" savedRecentFirst)\" == \"$(field "$json" recentFirst)\" && \"$(field "$json" refreshIntervalSec)\" == 30 ]]" "recent launch persistence preserves unrelated settings"
check "[[ -z \"$(field "$json" queryAfterLeave)\" ]]" "leaving the Excluded tab clears stale search"

exit "$((failures > 0))"
