#!/usr/bin/env bash
# test/probe/run -- deterministic mock-CLI probe suite for the S10 Process
# rework (exchange/23-s10-native-process-spec.md), its N6 fix-pass additions
# (exchange/25-fable-review-s10.md), and the S12 failed-start fix
# (exchange/28-s12-failed-start-spec.md, "removed" scenario below). Runs
# test/probe/service-probe.qml once per scenario via `qs -n -p ...` with
# PATH shadowed so every `mullvad`/`checkupdates` invocation resolves to
# test/mocks/-- NEVER the real daemon (no Wayland IPC to a running shell is
# touched; `qs -n` is a standalone, throwaway QML engine instance).
# PACMAN_LOCAL_DIR also points at a fixture pacman tree
# (test/fixtures/pacman-local) so scripts/mullvad-package-info never reads
# this box's real installed-package database either. Skips with a notice
# (exit 0) if no `qs` binary / Wayland session is available, per this
# project's test/all convention.
#
# Output goes to files (never a pipe -- block-buffering under `qs` swallows
# console.log otherwise, navi-omarchy-plugin-dev skill).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
OUT_DIR="$(mktemp -d)"
trap 'rm -rf "$OUT_DIR"' EXIT

fail_count=0
pass_count=0
ok() { pass_count=$((pass_count + 1)); echo "ok - $1"; }
not_ok() { fail_count=$((fail_count + 1)); echo "NOT OK - $1"; }

if ! command -v qs >/dev/null 2>&1; then
  echo "test/probe/run: no \`qs\` on PATH (no Wayland session?) -- skipping mock probe suite"
  exit 0
fi

# run_scenario <label> <VAR=val>... -- runs the probe once, with every
# trailing VAR=val argument exported alongside the fixed env below. `label`
# is only ever a filename/log key; the caller passes MULLVAD_MOCK_MODE (and
# any MULLVAD_PROBE_*/MOCK_MODE overrides) explicitly so scenario naming
# never has to double as CLI-mock-mode naming (N6 needs more scenarios than
# mock modes: e.g. two of the four updatecheck scenarios below share
# MULLVAD_MOCK_MODE=ok).
run_scenario() {
  local label="$1"; shift
  local log="$OUT_DIR/$label.log"
  local mocklog="$OUT_DIR/$label.mock.log"
  : > "$mocklog"
  # env, not a bare prefix-assignment list: "$@"'s expansion isn't visible to
  # bash's parser at the point it decides what counts as a `NAME=value`
  # prefix assignment (only literal, unexpanded words qualify), so a plain
  # `"$@" timeout ...` treats the FIRST expanded word as the command name
  # instead (measured while writing this: "MULLVAD_MOCK_MODE=ok: command
  # not found"). `env` parses its own argv for `NAME=value` pairs at
  # runtime, so it has no such restriction.
  env MULLVAD_MOCK_LOG="$mocklog" \
    MULLVAD_PLUGIN_DIR="$PLUGIN_DIR" \
    PACMAN_LOCAL_DIR="$PLUGIN_DIR/test/fixtures/pacman-local" \
    PATH="$PLUGIN_DIR/test/mocks:$PATH" \
    "$@" \
    timeout 30 qs -n -p "$PLUGIN_DIR/test/probe/service-probe.qml" > "$log" 2>&1
  echo "$?" > "$OUT_DIR/$label.exit"
  echo "$log"
}

json_line() { grep -o 'PROBE_RESULT .*' "$1" | tail -n1 | sed 's/^PROBE_RESULT //'; }

field() {
  # field <json> <key> -- deterministic single flat object, node available
  # everywhere this repo's tests already require node.
  node -e '
    try {
      const data = JSON.parse(process.argv[1]);
      const v = data[process.argv[2]];
      process.stdout.write(v === undefined || v === null ? "" : String(v));
    } catch (e) { process.stdout.write(""); }
  ' "$1" "$2"
}

# Kills any mock PID that (a) this run's mock log recorded and (b) is still
# alive after the qs process exited -- an orphan by definition, and counted
# as a failure regardless of what else passed (never silently swept aside).
# Shared by both test/mocks/mullvad and test/mocks/checkupdates -- both log
# "PID=<n> ..." lines to the same $MULLVAD_MOCK_LOG in the same format.
check_no_orphans() {
  local mocklog="$1" label="$2"
  local pids leaked=0
  pids="$(grep -oP '^PID=\K[0-9]+' "$mocklog" 2>/dev/null | sort -u)"
  for pid in $pids; do
    if kill -0 "$pid" 2>/dev/null; then
      leaked=1
      kill -TERM "$pid" 2>/dev/null || true
      sleep 0.2
      kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
      echo "  orphan: PID $pid was still alive after qs exited (killed by test/probe/run)"
    fi
  done
  if [[ $leaked -eq 1 ]]; then
    not_ok "$label: no orphaned mock process left behind"
  else
    ok "$label: no orphaned mock process left behind"
  fi
}

login_received_len_count() {
  # <mocklog> <n> -- count of "login-received-len=<n>" occurrences (the
  # mock indents this specific line with two leading spaces, unlike its
  # ARGV/PID lines -- no anchor on leading whitespace). grep -c always
  # prints exactly one line regardless of exit status (0 matches still
  # prints "0"), so no `|| echo 0` fallback here -- that pattern double-
  # prints on a genuine zero-match grep exit status 1.
  grep -c "login-received-len=$2\$" "$1" 2>/dev/null
}

echo "== ok mode (N1: connect, then login twice -- stdin reuse) =="
log="$(run_scenario ok MULLVAD_MOCK_MODE=ok MULLVAD_PROBE_DOUBLE_LOGIN=1)"
json="$(json_line "$log")"
mocklog="$OUT_DIR/ok.mock.log"
if [[ -z "$json" ]]; then
  not_ok "ok: probe printed a PROBE_RESULT line"
  cat "$log"
else
  ok "ok: probe printed a PROBE_RESULT line"
  [[ "$(field "$json" installed)" == "true" ]] && ok "ok: installed=true" || not_ok "ok: installed=true (got: $json)"
  [[ "$(field "$json" daemonRunning)" == "true" ]] && ok "ok: daemonRunning=true" || not_ok "ok: daemonRunning=true"
  [[ -z "$(field "$json" lastError)" ]] && ok "ok: lastError empty" || not_ok "ok: lastError empty (got: $(field "$json" lastError))"
  loc="$(field "$json" locationsLength)"
  [[ "${loc:-0}" -gt 0 ]] && ok "ok: relay locations parsed ($loc)" || not_ok "ok: relay locations parsed (got $loc)"
  # N1 (25-fable-review-s10.md): connectTunnel() runs first (an action that
  # writes no stdin, but still closes it in onStarted before this fix), then
  # TWO separate login() calls -- both must receive the full 16-char account
  # number. Pre-fix, only the FIRST action's stdin write ever lands; every
  # later login's write() goes into a stdin onStarted already closed once
  # and never reopened, so the mock reads an empty line and either reports
  # length 0 or the INVALID_INPUT error text instead.
  recv16="$(login_received_len_count "$mocklog" 16)"
  [[ "$recv16" -eq 2 ]] && ok "ok: both logins received exactly 16 stdin chars (stdin reuse after a prior action)" \
    || not_ok "ok: both logins received exactly 16 stdin chars (got $recv16 occurrences of len=16)"
  [[ "$(field "$json" actionStatus)" == "Logging in complete" ]] && ok "ok: login action completed" \
    || not_ok "ok: login action completed (got: $(field "$json" actionStatus))"
  note="$(field "$json" note)"
  [[ -z "$note" ]] && ok "ok: no harness-level note/timeout" || not_ok "ok: no harness-level note/timeout (got: $note)"
fi
check_no_orphans "$mocklog" "ok"

echo
echo "== fail mode =="
log="$(run_scenario fail MULLVAD_MOCK_MODE=fail)"
json="$(json_line "$log")"
mocklog="$OUT_DIR/fail.mock.log"
if [[ -z "$json" ]]; then
  not_ok "fail: probe printed a PROBE_RESULT line"
  cat "$log"
else
  ok "fail: probe printed a PROBE_RESULT line"
  [[ "$(field "$json" installed)" == "true" ]] && ok "fail: installed=true (--version still succeeds)" \
    || not_ok "fail: installed=true (got: $json)"
  [[ -n "$(field "$json" lastError)" ]] && ok "fail: error surfaced (lastError non-empty)" \
    || not_ok "fail: error surfaced (lastError non-empty)"
  invocations="$(grep -c '^PID=' "$mocklog" 2>/dev/null || echo 0)"
  [[ "$invocations" -gt 1 ]] && ok "fail: queue continued past the first failure ($invocations invocations)" \
    || not_ok "fail: queue continued past the first failure (got $invocations invocations)"
fi
check_no_orphans "$mocklog" "fail"

echo
echo "== hang mode =="
start_ts=$(date +%s)
log="$(run_scenario hang MULLVAD_MOCK_MODE=hang)"
end_ts=$(date +%s)
elapsed=$((end_ts - start_ts))
json="$(json_line "$log")"
mocklog="$OUT_DIR/hang.mock.log"
if [[ -z "$json" ]]; then
  not_ok "hang: probe printed a PROBE_RESULT line"
  cat "$log"
else
  ok "hang: probe printed a PROBE_RESULT line"
  err="$(field "$json" lastError)"
  note="$(field "$json" note)"
  # A hung read must surface as SOME failure, never a silent stall -- the
  # exact wording differs pre- vs post-rework (pre: the generic "not
  # installed" text, since the old bounded-command wrapper's own timeout is
  # what actually kills it; post: the QML watchdog's own "timed out" text),
  # so only require non-empty here and check the precise wording only where
  # this rework actually controls it (hasDebugCounters branch below).
  [[ -n "$err" && -z "$note" ]] \
    && ok "hang: read surfaced as a failure (lastError non-empty, no harness-level timeout)" \
    || not_ok "hang: read surfaced as a failure (got err=[$err] note=[$note])"
  hasCounters="$(field "$json" hasDebugCounters)"
  if [[ "$hasCounters" == "true" ]]; then
    fired="$(field "$json" readWatchdogFiredCount)"
    [[ "${fired:-0}" -ge 1 ]] && ok "hang: readWatchdogFiredCount >= 1 ($fired)" \
      || not_ok "hang: readWatchdogFiredCount >= 1 (got $fired)"
    # Not a substring check on lastError here: the read that actually hangs
    # in this harness is the "probe" kind (mullvad --version, always first
    # in the queue), whose _applyRead branch predates this rework and always
    # surfaces its own fixed "Mullvad CLI not found..." text regardless of
    # WHY the probe failed (unchanged, out of scope for S10) -- the watchdog
    # firing (checked above) is the actual proof the timeout mechanism ran.
    [[ "$elapsed" -le 11 ]] && ok "hang: recovered within ~11s (${elapsed}s, short readTimeoutMs)" \
      || not_ok "hang: recovered within ~11s (took ${elapsed}s)"
  else
    echo "  (pre-rework Service.qml: no debug counters yet -- recovery via scripts/bounded-command's own timeout, ${elapsed}s, not asserted tightly)"
  fi
fi
check_no_orphans "$mocklog" "hang"

echo
echo "== flood mode (N6: streaming flood, never exits on its own) =="
start_ts=$(date +%s)
log="$(run_scenario flood MULLVAD_MOCK_MODE=flood)"
end_ts=$(date +%s)
elapsed=$((end_ts - start_ts))
json="$(json_line "$log")"
mocklog="$OUT_DIR/flood.mock.log"
if [[ -z "$json" ]]; then
  not_ok "flood: probe printed a PROBE_RESULT line"
  cat "$log"
else
  ok "flood: probe printed a PROBE_RESULT line"
  chars="$(field "$json" readOutputChars)"
  hasCounters="$(field "$json" hasDebugCounters)"
  if [[ -n "$chars" ]]; then
    if [[ "$hasCounters" == "true" ]]; then
      cap_limit=262144
    else
      cap_limit=262145
    fi
    [[ "$chars" -le "$cap_limit" ]] && ok "flood: retained _readOutputChars bounded at or under the cap ($chars <= $cap_limit)" \
      || not_ok "flood: retained _readOutputChars bounded at or under the cap (got $chars, limit $cap_limit)"
  else
    echo "  (pre-rework Service.qml: _readOutputChars not exposed yet -- capping verified via wrapper head -c instead)"
  fi
  if [[ "$hasCounters" == "true" ]]; then
    overflow="$(field "$json" readOverflowCount)"
    [[ "${overflow:-0}" -ge 1 ]] && ok "flood: readOverflowCount >= 1 ($overflow)" \
      || not_ok "flood: readOverflowCount >= 1 (got $overflow)"
  fi
  # N6: this mock mode never exits on its own (an infinite loop) -- the only
  # way the whole qs run finishes this quickly is Service.qml actually
  # killing it. Generous bound (well above the ~1.5-2.5s the short probe
  # readTimeoutMs/killTimer need) to absorb qs's own startup/engine-init
  # overhead without becoming flaky; check_no_orphans below is the real,
  # PID-exact proof that the mock process itself is gone, not just that the
  # accounting looks right.
  [[ "$elapsed" -le 8 ]] && ok "flood: mock brought down promptly, not left streaming (${elapsed}s)" \
    || not_ok "flood: mock brought down promptly, not left streaming (took ${elapsed}s)"
fi
check_no_orphans "$mocklog" "flood"

echo
echo "== action-hang mode (N6: action watchdog, isolated from the read watchdog) =="
log="$(run_scenario action-hang MULLVAD_MOCK_MODE=action-hang MULLVAD_PROBE_ACTION_ONLY=1)"
json="$(json_line "$log")"
mocklog="$OUT_DIR/action-hang.mock.log"
if [[ -z "$json" ]]; then
  not_ok "action-hang: probe printed a PROBE_RESULT line"
  cat "$log"
else
  ok "action-hang: probe printed a PROBE_RESULT line"
  hasCounters="$(field "$json" hasDebugCounters)"
  if [[ "$hasCounters" == "true" ]]; then
    fired="$(field "$json" actionWatchdogFiredCount)"
    [[ "$fired" == "1" ]] && ok "action-hang: actionWatchdogFiredCount === 1" \
      || not_ok "action-hang: actionWatchdogFiredCount === 1 (got $fired)"
    err="$(field "$json" lastError)"
    [[ "$err" == *"timed out"* ]] && ok "action-hang: lastError mentions \"timed out\" ($err)" \
      || not_ok "action-hang: lastError mentions \"timed out\" (got: $err)"
  else
    not_ok "action-hang: hasDebugCounters (pre-rework Service.qml can't run this scenario meaningfully)"
  fi
fi
check_no_orphans "$mocklog" "action-hang"

echo
echo "== updateCheck path (N6: checkupdates shadowed, four scenarios) =="

run_updatecheck() {
  local scenario="$1" mock_mode="$2"
  local label="updatecheck-$scenario"
  local log json mocklog
  log="$(run_scenario "$label" MULLVAD_MOCK_MODE=ok MOCK_MODE="$mock_mode" MULLVAD_PROBE_CHECK_UPDATES=1)"
  json="$(json_line "$log")"
  mocklog="$OUT_DIR/$label.mock.log"
  if [[ -z "$json" ]]; then
    not_ok "updatecheck-$scenario: probe printed a PROBE_RESULT line"
    cat "$log"
    check_no_orphans "$mocklog" "updatecheck-$scenario"
    return
  fi
  ok "updatecheck-$scenario: probe printed a PROBE_RESULT line"
  local hasCounters status targets fired packages
  hasCounters="$(field "$json" hasDebugCounters)"
  status="$(field "$json" updateCheckStatus)"
  targets="$(field "$json" updateTargetsLength)"
  fired="$(field "$json" updateCheckWatchdogFiredCount)"
  packages="$(field "$json" packagesLength)"
  [[ "${packages:-0}" -ge 1 ]] && ok "updatecheck-$scenario: fixture packages populated ($packages)" \
    || not_ok "updatecheck-$scenario: fixture packages populated (got $packages -- checkForUpdates() would have refused to run)"
  case "$scenario" in
    none)
      [[ "$status" == "ok" ]] && ok "updatecheck-none: updateCheckStatus=ok" || not_ok "updatecheck-none: updateCheckStatus=ok (got $status)"
      [[ "${targets:-0}" -eq 0 ]] && ok "updatecheck-none: no update targets" || not_ok "updatecheck-none: no update targets (got $targets)"
      ;;
    updates)
      [[ "$status" == "ok" ]] && ok "updatecheck-updates: updateCheckStatus=ok" || not_ok "updatecheck-updates: updateCheckStatus=ok (got $status)"
      [[ "${targets:-0}" -ge 1 ]] && ok "updatecheck-updates: update targets parsed ($targets)" || not_ok "updatecheck-updates: update targets parsed (got $targets)"
      ;;
    offline)
      [[ "$status" == "unavailable" ]] && ok "updatecheck-offline: updateCheckStatus=unavailable" || not_ok "updatecheck-offline: updateCheckStatus=unavailable (got $status)"
      if [[ "$hasCounters" == "true" ]]; then
        [[ "${fired:-0}" -eq 0 ]] && ok "updatecheck-offline: watchdog did not fire ($fired)" || not_ok "updatecheck-offline: watchdog did not fire (got $fired)"
      fi
      ;;
    hang)
      [[ "$status" == "unavailable" ]] && ok "updatecheck-hang: updateCheckStatus=unavailable" || not_ok "updatecheck-hang: updateCheckStatus=unavailable (got $status)"
      if [[ "$hasCounters" == "true" ]]; then
        [[ "${fired:-0}" -ge 1 ]] && ok "updatecheck-hang: updateCheckWatchdogFiredCount >= 1 ($fired)" \
          || not_ok "updatecheck-hang: updateCheckWatchdogFiredCount >= 1 (got $fired)"
      else
        echo "  (pre-rework Service.qml: no updateCheckWatchdog counter yet)"
      fi
      ;;
  esac
  check_no_orphans "$mocklog" "updatecheck-$scenario"
}

run_updatecheck none none
run_updatecheck updates updates
run_updatecheck offline offline
run_updatecheck hang hang

echo
echo "== removed mode (S12: mullvad binary vanishes mid-run) =="

# S12 (28-s12-failed-start-spec.md): a per-run temp PATH dir holding ONLY a
# symlink `mullvad` -> test/mocks/mullvad, placed ahead of a filtered
# fallback PATH -- deliberately NOT the usual "$PLUGIN_DIR/test/mocks:$PATH"
# every other scenario uses. test/mocks/mullvad is the exact file the
# symlink points at, so if test/mocks were also reachable afterwards,
# deleting just the symlink would not actually make `mullvad` unresolvable
# (PATH search continues into the next directory that still has it) --
# measured live, scratchpad/s12/linktest2/: with test/mocks appended after
# the temp dir, `command -v mullvad` still resolved post-removal; without
# it, resolution genuinely failed (exit 127), which is what this scenario
# needs. The fallback PATH is also stripped of whatever directory a REAL
# system `mullvad` might resolve from first (house rule: never let a
# dev/test session reach the real CLI, `CLAUDE.md` rule 6) -- on this box
# `mullvad` is currently uninstalled so this is a no-op, but the guard
# holds on any machine where it might not be.
REMOVED_PATH_DIR="$OUT_DIR/removed-path"
mkdir -p "$REMOVED_PATH_DIR"
ln -sf "$PLUGIN_DIR/test/mocks/mullvad" "$REMOVED_PATH_DIR/mullvad"
SAFE_FALLBACK_PATH="$PATH"
if real_mullvad="$(command -v mullvad 2>/dev/null)"; then
  real_mullvad_dir="$(dirname "$real_mullvad")"
  SAFE_FALLBACK_PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -v -x "$real_mullvad_dir" | paste -sd: -)"
fi

log="$OUT_DIR/removed.log"
mocklog="$OUT_DIR/removed.mock.log"
: > "$mocklog"
start_ts=$(date +%s)
env MULLVAD_MOCK_LOG="$mocklog" \
  MULLVAD_PLUGIN_DIR="$PLUGIN_DIR" \
  PACMAN_LOCAL_DIR="$PLUGIN_DIR/test/fixtures/pacman-local" \
  MULLVAD_MOCK_LINK="$REMOVED_PATH_DIR/mullvad" \
  MULLVAD_MOCK_MODE=ok \
  MULLVAD_PROBE_REMOVED=1 \
  PATH="$REMOVED_PATH_DIR:$SAFE_FALLBACK_PATH" \
  timeout 30 qs -n -p "$PLUGIN_DIR/test/probe/service-probe.qml" > "$log" 2>&1
end_ts=$(date +%s)
elapsed=$((end_ts - start_ts))
json="$(json_line "$log")"
if [[ -z "$json" ]]; then
  not_ok "removed: probe printed a PROBE_RESULT line"
  cat "$log"
else
  ok "removed: probe printed a PROBE_RESULT line"
  [[ "$(field "$json" daemonRunning)" == "false" ]] && ok "removed: daemonRunning=false" \
    || not_ok "removed: daemonRunning=false (got: $json)"
  [[ "$(field "$json" installed)" == "false" ]] && ok "removed: installed=false" \
    || not_ok "removed: installed=false (got: $(field "$json" installed))"
  [[ "$(field "$json" state)" == "unavailable" ]] && ok "removed: state=unavailable" \
    || not_ok "removed: state=unavailable (got: $(field "$json" state))"
  [[ -n "$(field "$json" lastError)" ]] && ok "removed: lastError non-empty" \
    || not_ok "removed: lastError non-empty"
  # Proof this recovered via the new failed-start finalize path, not the
  # 1.5s read watchdog (which would also eventually surface a failure, just
  # on a slower, unrelated path this scenario isn't testing).
  fired="$(field "$json" readWatchdogFiredCount)"
  [[ "${fired:-1}" -eq 0 ]] && ok "removed: readWatchdogFiredCount === 0 (via failed-start path, not the watchdog) ($fired)" \
    || not_ok "removed: readWatchdogFiredCount === 0 (got $fired)"
  [[ "$elapsed" -lt 6 ]] && ok "removed: elapsed < 6s (${elapsed}s)" \
    || not_ok "removed: elapsed < 6s (took ${elapsed}s)"
  # Action variant (in the same run): connectTunnel() was called right
  # after the removal, while `installed` was still stale-true, so it
  # genuinely reached actionProcess's own failed-start path instead of
  # bailing out early at _command()'s `!installed` guard.
  actionStatus="$(field "$json" actionStatus)"
  [[ "$actionStatus" != "Connecting…" ]] && ok "removed: actionStatus reads as a failure, not stuck at \"Connecting…\" (got: $actionStatus)" \
    || not_ok "removed: actionStatus reads as a failure, not stuck at \"Connecting…\""
  [[ "$(field "$json" busy)" == "false" ]] && ok "removed: busy=false" \
    || not_ok "removed: busy=false (got: $(field "$json" busy))"
fi
check_no_orphans "$mocklog" "removed"

echo
if [[ "$fail_count" -eq 0 ]]; then
  echo "test/probe/run: ALL CHECKS PASSED ($pass_count ok)"
else
  echo "test/probe/run: $fail_count FAILURE(S), $pass_count ok"
fi
exit $(( fail_count > 0 ? 1 : 0 ))
