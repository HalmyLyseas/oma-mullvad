#!/usr/bin/env bash
# Runs every test suite in this repo: Node unit tests, the scripts.test.sh
# suite against fixtures/mocks, the read-only Mullvad CLI contract check,
# then test/probe/run's mock-CLI probe suite. Exits non-zero on any failure.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
overall=0

echo "== node --test (Model.js, bounded-command, QML Text sinks) =="
node --test "$SCRIPT_DIR"/*.test.js
if [[ $? -ne 0 ]]; then overall=1; fi

echo
echo "== scripts (bash, checkupdates shadowed by test/mocks/checkupdates) =="
bash "$SCRIPT_DIR/scripts.test.sh"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
echo "== cli-contract.mjs (read-only against the real mullvad CLI) =="
node "$SCRIPT_DIR/cli-contract.mjs"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
echo "== test/probe/run (deterministic mock-CLI probe suite, S10) =="
bash "$SCRIPT_DIR/probe/run"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
if [[ $overall -eq 0 ]]; then
  echo "test/all: ALL SUITES PASSED"
else
  echo "test/all: FAILURES ABOVE"
fi
exit $overall
