#!/usr/bin/env bash
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
status=0

node --test "$root/tests"/*.test.js || status=1
bash "$root/tests/run-cli-contract" || status=1
bash "$root/tests/probe/run" || status=1
bash "$root/tests/probe/run-ui" || status=1
bash "$root/tests/quicktest/run" || status=1
bash "$root/tests/probe/run-settings" || status=1
exit "$status"
