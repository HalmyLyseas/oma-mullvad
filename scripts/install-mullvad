#!/bin/bash
# The ONLY file in this plugin allowed to contain a package-manager/
# service-manager/sudo literal (CLAUDE.md rule 4). Launched only from a
# ConfirmDialog-gated button in Panel.qml; see docs/developers.md, "Install prompt".
set -euo pipefail

echo "Installing Mullvad VPN..."
omarchy-pkg-add mullvad-vpn

echo "Enabling Mullvad daemon..."
if ! systemctl is-active --quiet mullvad-daemon; then
  sudo systemctl enable --now mullvad-daemon
fi
