#!/bin/bash
# Read-only `checkupdates` wrapper reporting only the two Mullvad packages.
# Exit 0 = checked (updates or none), 3 = could not check (offline/lock/timeout).
# checkupdates runs backgrounded so a TERM to this script is relayed to it via the trap.
set -uo pipefail

timeout_seconds="${MULLVAD_UPDATE_CHECK_TIMEOUT:-120}"

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

timeout "$timeout_seconds" checkupdates --nocolor >"$tmp" 2>/dev/null &
child=$!

forward_signal() {
  kill -TERM "$child" 2>/dev/null
  wait "$child" 2>/dev/null
  exit 143
}
trap forward_signal TERM INT

wait "$child"
status=$?
trap - TERM INT

case "$status" in
  2)
    exit 0
    ;;
  0)
    ;;
  *)
    # 1 = offline/db-lock/error, 124 = our own timeout.
    exit 3
    ;;
esac

awk '
  $1 == "mullvad-vpn" || $1 == "mullvad-vpn-daemon" { print $1 "\t" $2 "\t" $4 }
' "$tmp"
exit 0
